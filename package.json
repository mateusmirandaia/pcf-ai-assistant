{
  "name": "pcf-ai-assistant",
  "version": "0.1.0",
  "description": "PCF field control that suggests replies for Dynamics 365 cases and emails through a backend proxy to Azure OpenAI.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "pcf-scripts build",
    "build:prod": "pcf-scripts build --buildMode production",
    "clean": "pcf-scripts clean",
    "rebuild": "pcf-scripts rebuild",
    "refreshTypes": "pcf-scripts refreshTypes",
    "start": "pcf-scripts start",
    "start:watch": "pcf-scripts start watch",
    "lint": "eslint AiReplyAssistant",
    "lint:fix": "eslint AiReplyAssistant --fix",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fluentui/react-components": "9.68.0",
    "react": "16.14.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@microsoft/eslint-plugin-power-apps": "^0.5.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^14.6.12",
    "@types/jest": "^30.0.0",
    "@types/powerapps-component-framework": "^1.3.18",
    "@types/react": "^16.14.70",
    "@types/react-dom": "^16.9.25",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "pcf-scripts": "^1.51.1",
    "pcf-start": "^1.51.1",
    "react-dom": "^16.14.0",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
